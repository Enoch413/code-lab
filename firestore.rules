rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == 'admin';
    }

    function isFullAdmin() {
      return isAdmin() && userDoc().data.get('adminScope', '') == 'all';
    }

    function canReadUser() {
      return isFullAdmin() || (isAdmin()
        && resource.data.get('classIds', []).hasAny(userDoc().data.get('classIds', [])));
    }

    function ownsRetryData() {
      return isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    function retryIdBelongsToOwner(docId) {
      return docId.split('__')[0] == request.auth.uid.lower();
    }

    function isActive() {
      return signedIn() && userDoc().data.get('loginDisabled', false) == false;
    }

    function canUseRegularPortal() {
      return isActive() && (isAdmin() || (
        userDoc().data.get('classIds', []).size() > 0
        && !userDoc().data.get('classIds', []).hasAny(['class-grammar-only'])
      ));
    }

    function manages(data) {
      return isFullAdmin() || (isAdmin()
        && data.get('classIds', []).hasAny(userDoc().data.get('classIds', [])));
    }

    function owns(data) {
      return isActive() && data.get('userId', '') == request.auth.uid;
    }

    function ownWrite(data) {
      return owns(data) && data.get('classIds', []).size() > 0
        && data.get('classIds', []).hasOnly(userDoc().data.get('classIds', []));
    }

    function publicCounselSlot(data) {
      return data.keys().hasOnly(['id', 'requestId', 'userId', 'classId', 'classIds',
        'requestedAt', 'startAt', 'endAt', 'status', 'updatedAt', 'createdAt',
        'releasedAt', 'releaseReason', 'canceledAt']);
    }

    function assignedMaterial(data) {
      return isFullAdmin() || (data.get('accessSchemaVersion', 0) == 1 && (manages(data) || (canUseRegularPortal() && !isAdmin() && (
        request.auth.uid in data.get('targetUserIds', [])
        || (data.get('assignmentMode', '') == 'class'
          && data.get('classIds', []).hasAny(userDoc().data.get('classIds', [])))
      ))));
    }

    function managesNewMaterial(data) {
      return isFullAdmin() || (isAdmin() && data.get('classIds', []).size() > 0
        && data.get('classIds', []).hasOnly(userDoc().data.get('classIds', [])));
    }

    function validMaterial(data) {
      return data.get('accessSchemaVersion', 0) == 1
        && data.get('classIds', []).size() == 1
        && data.get('targetUserIds', []) is list
        && (data.get('assignmentMode', '') == 'class' && data.get('targetUserIds', []).size() == 0
          || data.get('assignmentMode', '') == 'personal' && data.get('targetUserIds', []).size() > 0);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || canReadUser();
      allow create: if isFullAdmin() || (isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
        && request.resource.data.get('adminScope', '') in ['', 'assigned']
        && request.resource.data.get('classIds', []) == []
        && request.resource.data.get('grammarAccessMode', 'none') == 'none'
        && request.resource.data.get('grammarObjectPaths', []) == []);
      allow update: if isFullAdmin() || (
        isOwner(userId) && isActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordResetRequired', 'updatedAt']) &&
        request.resource.data.passwordResetRequired is bool &&
        request.resource.data.updatedAt is string
      );
      allow delete: if false;
    }

    match /checkResponses/{responseId} {
      allow get: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data)
        || (responseId.split('__')[0] == request.auth.uid
          && !exists(/databases/$(database)/documents/checkResponses/$(responseId))));
      allow list: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
      allow create: if canUseRegularPortal() && (managesNewMaterial(request.resource.data)
        || (ownWrite(request.resource.data) && responseId.split('__')[0] == request.auth.uid));
      allow update: if canUseRegularPortal() && request.resource.data.userId == resource.data.userId && (manages(resource.data) && managesNewMaterial(request.resource.data)
        || (owns(resource.data) && ownWrite(request.resource.data)
          && responseId.split('__')[0] == request.auth.uid));
      allow delete: if canUseRegularPortal() && manages(resource.data);
    }

    match /prepVideoProgress/{progressId} {
      allow get: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data)
        || (progressId.split('__')[0] == request.auth.uid
          && !exists(/databases/$(database)/documents/prepVideoProgress/$(progressId))));
      allow list: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
      allow create: if canUseRegularPortal() && (managesNewMaterial(request.resource.data)
        || (ownWrite(request.resource.data) && progressId.split('__')[0] == request.auth.uid));
      allow update: if canUseRegularPortal() && request.resource.data.userId == resource.data.userId && (manages(resource.data) && managesNewMaterial(request.resource.data)
        || (owns(resource.data) && ownWrite(request.resource.data)
          && progressId.split('__')[0] == request.auth.uid));
      allow delete: if canUseRegularPortal() && manages(resource.data);
    }

    match /grammarVideoProgress/{progressId} {
      allow get: if isActive() && (manages(resource.data) || owns(resource.data)
        || (progressId.split('__')[0] == request.auth.uid
          && !exists(/databases/$(database)/documents/grammarVideoProgress/$(progressId))));
      allow list: if isActive() && (manages(resource.data) || owns(resource.data));
      allow create: if isActive() && (managesNewMaterial(request.resource.data)
        || (ownWrite(request.resource.data) && progressId.split('__')[0] == request.auth.uid));
      allow update: if isActive() && request.resource.data.userId == resource.data.userId && (manages(resource.data) && managesNewMaterial(request.resource.data)
        || (owns(resource.data) && ownWrite(request.resource.data)
          && progressId.split('__')[0] == request.auth.uid));
      allow delete: if isActive() && (manages(resource.data) || owns(resource.data));
    }

    match /counselRequests/{requestId} {
      allow get: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data)
        || (requestId.split('__')[0] == request.auth.uid
          && !exists(/databases/$(database)/documents/counselRequests/$(requestId))));
      allow list: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
      allow create: if canUseRegularPortal() && (managesNewMaterial(request.resource.data)
        || (ownWrite(request.resource.data) && requestId.split('__')[0] == request.auth.uid));
      allow update: if canUseRegularPortal() && request.resource.data.userId == resource.data.userId && (manages(resource.data) && managesNewMaterial(request.resource.data)
        || (owns(resource.data) && ownWrite(request.resource.data)
          && requestId.split('__')[0] == request.auth.uid));
      allow delete: if canUseRegularPortal() && manages(resource.data);
    }

    // Slot occupancy must be readable for conflict detection; request contents stay private.
    match /counselSlots/{slotId} {
      allow get: if canUseRegularPortal() && (
        !exists(/databases/$(database)/documents/counselSlots/$(slotId))
        || publicCounselSlot(resource.data) || manages(resource.data) || owns(resource.data));
      allow list: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
      allow create: if canUseRegularPortal() && publicCounselSlot(request.resource.data) && ownWrite(request.resource.data)
        && request.resource.data.status == 'open';
      allow update: if canUseRegularPortal()
        && (publicCounselSlot(request.resource.data)
          || (!publicCounselSlot(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))) && (
        (manages(resource.data) && managesNewMaterial(request.resource.data))
        || (ownWrite(request.resource.data) && (
          resource.data.status in ['completed', 'canceled', 'cancelled']
          || owns(resource.data))));
      allow delete: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
    }

    // Legacy aggregate documents contain other classes' material and need an explicit split.
    match /portalContent/{docId} {
      allow read, create, update: if isFullAdmin();
      allow delete: if false;
    }

    match /portalPrepSets/{docId} {
      allow read: if canUseRegularPortal() && assignedMaterial(resource.data);
      allow create: if canUseRegularPortal() && managesNewMaterial(request.resource.data) && validMaterial(request.resource.data);
      allow update: if canUseRegularPortal() && (isFullAdmin() || resource.data.get('accessSchemaVersion', 0) == 1) && managesNewMaterial(resource.data) && managesNewMaterial(request.resource.data) && validMaterial(request.resource.data);
      allow delete: if canUseRegularPortal() && (isFullAdmin() || resource.data.get('accessSchemaVersion', 0) == 1) && managesNewMaterial(resource.data);
    }

    match /portalCheckSets/{docId} {
      allow read: if canUseRegularPortal() && assignedMaterial(resource.data);
      allow create: if canUseRegularPortal() && managesNewMaterial(request.resource.data) && validMaterial(request.resource.data);
      allow update: if canUseRegularPortal() && (isFullAdmin() || resource.data.get('accessSchemaVersion', 0) == 1) && managesNewMaterial(resource.data) && managesNewMaterial(request.resource.data) && validMaterial(request.resource.data);
      allow delete: if canUseRegularPortal() && (isFullAdmin() || resource.data.get('accessSchemaVersion', 0) == 1) && managesNewMaterial(resource.data);
    }

    match /pdfLabSharedLibraryImports/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pdfLabSharedLibraryProblems/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pdfLabStudentRetryPrefs/{docId} {
      allow get: if isAdmin() && ((docId == request.auth.uid && !exists(/databases/$(database)/documents/pdfLabStudentRetryPrefs/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && docId == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetryStudents/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetryStudents/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetrySessions/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetrySessions/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetryStudentStates/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetryStudentStates/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetryExamSets/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetryExamSets/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetryExamItems/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetryExamItems/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /pdfLabStudentRetryWorks/{docId} {
      allow get: if isAdmin() && ((retryIdBelongsToOwner(docId) && !exists(/databases/$(database)/documents/pdfLabStudentRetryWorks/$(docId))) || resource.data.ownerUid == request.auth.uid);
      allow list, delete: if ownsRetryData();
      allow create: if isAdmin() && retryIdBelongsToOwner(docId) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsRetryData() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /questionIssues/{issueId} {
      allow read: if canUseRegularPortal() && (manages(resource.data) || owns(resource.data));
      allow create: if canUseRegularPortal() && ownWrite(request.resource.data);
      allow update: if canUseRegularPortal() && (
        (manages(resource.data) && managesNewMaterial(request.resource.data))
        || (owns(resource.data) && ownWrite(request.resource.data)));
      allow delete: if canUseRegularPortal() && manages(resource.data);
    }
  }
}
